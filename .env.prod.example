COMPOSE_PROJECT_NAME=fiscal-control-engine

# Ports bindes sur localhost pour etre publies par Nginx/Caddy.
API_HOST_PORT=8001
FRONT_HOST_PORT=3009
POSTGRES_HOST_PORT=5435

# Base de donnees dediee au projet.
POSTGRES_DB=fiscal_control
POSTGRES_USER=fiscal_control
POSTGRES_PASSWORD=

# URL publique finale.
NEXT_PUBLIC_BASE_URL=https://fiscal.example.com
NEXT_PUBLIC_API_BASE_URL=/api
API_URL=http://api:8000
CORS_ORIGINS=["https://fiscal.example.com"]

# Secrets et providers LLM.
RAS_FACT_CONTEXT_SIGNING_KEY=
LLM_PROVIDER_CHAIN=openai-compatible:gpt-5-mini,internal:controlled-response
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
LLM_GEMINI_API_KEY=
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_GROQ_API_KEY=
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_DEFAULT_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200

# Limites et stockage.
AGENT_FILE_TTL_SECONDS=86400
AGENT_FILE_MAX_UPLOAD_BYTES=20000000
AGENT_MAX_ANSWER_CHARACTERS=4000
RAS_BATCH_MAX_CANDIDATES=5000

# Garder disabled sur le VPS actuel; les embeddings locaux consommeraient trop.
RAG_EMBEDDING_PROVIDER=disabled
RAS_SEMANTIC_EMBEDDING_PROVIDER=disabled
