APP_NAME=Bank Files Harmonizer API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3002"]
RAS_CLASSIFICATION_RULES_PATH=/workspace/docs/reference/ras-classification-rules.csv
POSTING_KEY_RULES_PATH=/workspace/docs/reference/sap-posting-key-rules.csv
ACCOUNT_BALANCE_RULES_PATH=/workspace/docs/reference/syscohada-account-balance-rules.csv
RAS_GL_COLUMN_ALIASES_PATH=/workspace/docs/reference/ras-gl-column-aliases.csv
RAS_CANDIDATE_SIGNALS_PATH=/workspace/docs/reference/ras-candidate-signals.csv
RAS_SEMANTIC_POLICY_PATH=/workspace/docs/reference/ras-semantic-classification-policy.csv
# Activer apres installation de l'extra Python `embeddings` et calibration du modele.
RAS_SEMANTIC_EMBEDDING_PROVIDER=disabled
RAS_SEMANTIC_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAS_LEGAL_RULES_PATH=/workspace/docs/reference/bf-ras-legal-rules.csv
RAS_LEGAL_REPOSITORY_ROOT_PATH=/workspace
RAS_TAX_EVENT_RULES_PATH=/workspace/docs/reference/bf-ras-tax-event-rules.csv
RAS_CALCULATION_PARAMETERS_PATH=/workspace/docs/reference/bf-ras-calculation-parameters.csv
RAS_ACCOUNTING_ASSESSMENT_POLICY_PATH=/workspace/docs/reference/ras-accounting-assessment-policy.csv
RAS_USER_FACT_PATTERNS_PATH=/workspace/docs/reference/ras-user-fact-patterns.csv
# Secret distinct des cles API, 32 caracteres minimum. Requis avant activation des tools juridiques RAS.
RAS_FACT_CONTEXT_SIGNING_KEY=
TAX_RAG_SOURCE_ROOT_PATH=/workspace/docs/source-corpus/fiscal
RAS_LEDGER_ACCOUNT_MAPPING_PATH=/workspace/docs/reference/ras-ledger-account-mapping.organization.csv
# A renseigner uniquement si tout fichier charge appartient a cette societe.
RAS_DEFAULT_COMPANY_CODE=
# Limite serveur du nombre de candidats persistes par audit batch (1 a 20000).
RAS_BATCH_MAX_CANDIDATES=5000
VAT_VALIDATION_RULES_PATH=/workspace/docs/reference/bf-vat-validation-rules.csv
WITHHOLDING_VALIDATION_RULES_PATH=/workspace/docs/reference/bf-withholding-validation-rules.csv
WITHHOLDING_DEADLINE_RULES_PATH=/workspace/docs/reference/bf-withholding-deadline-rules.csv
PAYROLL_TAX_VALIDATION_RULES_PATH=/workspace/docs/reference/bf-iuts-validation-rules.csv
CORPORATE_INCOME_TAX_VALIDATION_RULES_PATH=/workspace/docs/reference/bf-is-validation-rules.csv
TAX_ASSURANCE_POLICY_PATH=/workspace/docs/reference/bf-tax-assurance-policy.csv
ACCOUNT_MAPPING_LEDGER_ACCOUNTS_PATH=/workspace/api/app/account_mapping/tests/fixtures/ledger_accounts.csv
ACCOUNT_MAPPING_PLAN_ACCOUNTS_PATH=/workspace/api/app/account_mapping/tests/fixtures/plan_accounts.csv
# `deterministic` est reserve aux tests et ne declenche pas le reranking semantique.
RAG_EMBEDDING_PROVIDER=disabled
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_PROVIDER_CHAIN=internal:controlled-response
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
EXCEL_AGENT_ALLOWED_ROOT_PATH=/workspace/docs
AGENT_MAX_ANSWER_CHARACTERS=4000
AGENT_FILE_STORAGE_ROOT_PATH=/workspace/.local/agent-files
AGENT_FILE_TTL_SECONDS=86400
AGENT_FILE_MAX_UPLOAD_BYTES=20000000
DATABASE_URL=postgresql+psycopg://harmonizer:harmonizer@db:5432/harmonizer
